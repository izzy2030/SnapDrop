{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapDrop",
  "version": "1.0.1",
  "identifier": "com.snapdrop.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SnapDrop",
        "width": 1176,
        "height": 693,
        "minWidth": 880,
        "minHeight": 546,
        "center": true,
        "resizable": true,
        "visible": true
      },
      {
        "label": "thumbnail",
        "title": "SnapDrop Capture",
        "url": "thumbnail.html",
        "width": 320,
        "height": 240,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false
      },
      {
        "label": "editor",
        "title": "SnapDrop Editor",
        "url": "editor.html",
        "width": 960,
        "height": 640,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": true
      },
    {
      "label": "recorder_toolbar",
      "title": "SnapDrop Recorder",
      "url": "recorder.html",
      "width": 360,
      "height": 80,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false
      },
      {
        "label": "recorder_border",
        "title": "SnapDrop Recorder Border",
        "url": "recorder_border.html",
        "width": 320,
        "height": 200,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Square30x30Logo.png",
      "icons/Square44x44Logo.png",
      "icons/Square71x71Logo.png",
      "icons/Square89x89Logo.png",
      "icons/Square107x107Logo.png",
      "icons/Square142x142Logo.png",
      "icons/Square150x150Logo.png",
      "icons/Square284x284Logo.png",
      "icons/Square310x310Logo.png",
      "icons/StoreLogo.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
